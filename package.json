{
  "name": "ticket-dapp",
  "version": "0.1.0",
  "description": "TourChain: on-chain tour booking and ticket management with MetaMask",
  "scripts": {
    "dev": "vite",
    "start:local": "node scripts/start-local.mjs",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost --build-profile production",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia --build-profile production",
    "export:abi": "node scripts/export-abi.mjs",
    "build": "hardhat build --build-profile production && node scripts/export-abi.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test test/frontend.test.js test/integration.test.js",
    "test:e2e": "playwright test",
    "check": "node --check app.js && node --check src/ui/customerApp.js && node --check src/ui/adminApp.js && node --check src/ui/deployApp.js && node --check src/config/frontend.js && node --check src/config/blockchain.js && node --check src/contracts/tourTicketAbi.js && node --check src/blockchain/errors.js && node --check src/services/walletService.js && node --check src/services/ticketService.js && node --check scripts/start-local.mjs",
    "compile:contracts": "hardhat build",
    "typecheck:contracts": "hardhat build && tsc --noEmit",
    "test:contracts": "hardhat test",
    "node:contracts": "hardhat node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NhutThanh4343/Ticket-Dapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/NhutThanh4343/Ticket-Dapp/issues"
  },
  "homepage": "https://github.com/NhutThanh4343/Ticket-Dapp#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "dotenv": "^18.0.9",
    "forge-std": "git+https://github.com/foundry-rs/forge-std.git#v1.16.2",
    "hardhat": "^3.21.1",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.5"
  },
  "private": true,
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
