# Public Vite configuration. Fill in the TESTNET deployment values before use.
# VITE_* values are visible in the browser. Never put private keys here.
# Only blockchain is supported. start:local and deploy commands fill .env.local.
# Configuration/RPC errors never fall back to sample data.
VITE_DATA_MODE=blockchain
VITE_CHAIN_ID=
VITE_RPC_URL=
VITE_CONTRACT_ADDRESS=
VITE_ADMIN_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
