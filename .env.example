# Public Vite configuration. Fill in the TESTNET deployment values before use.
# VITE_* values are visible in the browser. Never put private keys here.
# Explicit modes: demo (read-only sample tours) or blockchain (real RPC/wallet).
# Blockchain mode NEVER falls back to demo on configuration/RPC errors.
VITE_DATA_MODE=demo
VITE_CHAIN_ID=
VITE_RPC_URL=
VITE_CONTRACT_ADDRESS=
VITE_ADMIN_ADDRESS=
